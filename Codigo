import sqlite3
import pandas as pd

# Crear una conexión a una base de datos SQLite en memoria
conn = sqlite3.connect(':memory:')
cursor = conn.cursor()

# SQL script consolidado
sql_script = """
-- ==========================================
-- 1. PREPARACIÓN Y CREACIÓN DE LA TABLA
-- ==========================================

-- Crear la tabla vendedores si no existe
CREATE TABLE IF NOT EXISTS vendedores (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    ventas_totales REAL,
    zona TEXT,
    fecha_ingreso TEXT
);

-- Insertar registros iniciales de prueba
INSERT INTO vendedores (nombre, ventas_totales, zona, fecha_ingreso) VALUES 
('Ana Pérez', 8500.0, 'Norte', '2024-03-15'),
('Carlos Gómez', 12000.5, 'Sur', '2023-11-10'),
('Lucía Fernández', 4500.0, 'Norte', '2025-01-20');

-- ==========================================
-- 2. EXPANSIÓN (INSERT)
-- ==========================================

-- Insertar dos nuevos vendedores individualmente
INSERT INTO vendedores (nombre, ventas_totales, zona, fecha_ingreso) 
VALUES ('Esteban Quito', 9500.0, 'Oeste', '2025-05-12');

INSERT INTO vendedores (nombre, ventas_totales, zona, fecha_ingreso) 
VALUES ('Valeria Ríos', 11200.0, 'Este', '2024-08-01');

-- INSERT masivo (3 registros en una sola sentencia)
INSERT INTO vendedores (nombre, ventas_totales, zona, fecha_ingreso) VALUES 
('Martín Fierro', 3000.0, 'Norte', '2025-06-10'),
('Sofía Benítez', 15400.0, 'Centro', '2023-05-18'),
('Test Vendedor', 500.0, 'Prueba', '2026-10-01');

-- ==========================================
-- 3. MANTENIMIENTO (UPDATE)
-- ==========================================

-- Actualizar ventas del vendedor con id = 2 sumándole 500 unidades
UPDATE vendedores 
SET ventas_totales = ventas_totales + 500 
WHERE id = 2;

-- Reto: Cambiar la zona a 'Internacional' para vendedores con más de 10,000 en ventas
UPDATE vendedores 
SET zona = 'Internacional' 
WHERE ventas_totales > 10000;

-- ==========================================
-- 4. LIMPIEZA (DELETE Y VERIFICACIÓN)
-- ==========================================

-- Eliminar el vendedor de prueba identificado por su nombre o id
DELETE FROM vendedores 
WHERE nombre = 'Test Vendedor';
"""

# Ejecutar el script SQL
cursor.executescript(sql_script)
conn.commit()

# Realizar la consulta final y mostrarla con pandas
df_resultado = pd.read_sql_query("SELECT * FROM vendedores;", conn)
print("Verificación final (Tabla vendedores):")
display(df_resultado)

# Cerrar la conexión
conn.close()
